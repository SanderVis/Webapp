{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observation (raw layer)",
  "type": "object",
  "required": [
    "disease_id",
    "study_id",
    "cohort_id",
    "status",
    "source_location",
    "evidence_access",
    "extraction_confidence",
    "original_text"
  ],
  "properties": {
    "disease_id": {
      "type": "string"
    },
    "feature_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "gestandaardiseerd id (verplicht in normalized/, optioneel in raw/)"
    },
    "domain": {
      "enum": [
        "clinical",
        "laboratory",
        "imaging",
        "functional",
        "microbiology",
        "epidemiology",
        "treatment",
        "pathology",
        "diagnostic_accuracy",
        "outcome"
      ]
    },
    "study_id": {
      "type": "string"
    },
    "cohort_id": {
      "type": "string"
    },
    "pmid": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "present",
        "absent",
        "not_reported",
        "not_assessed",
        "unclear"
      ]
    },
    "positive_n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "percentage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "derived": {
      "type": "boolean",
      "description": "true = percentage berekend uit n/N die in de bron staan"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "stat": {
      "type": [
        "object",
        "null"
      ],
      "description": "originele vorm: mean/sd/median/q1/q3/min/max/n",
      "additionalProperties": true
    },
    "reference_range": {
      "type": [
        "string",
        "null"
      ]
    },
    "cutoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "timing": {
      "enum": [
        "early",
        "acute",
        "acute_peak",
        "hyperinflammatory",
        "recovery",
        "chronic",
        "relapse",
        "at_diagnosis",
        "unspecified"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_location": {
      "type": "string",
      "description": "bijv. Table 2, Results par. 3"
    },
    "original_text": {
      "type": "string",
      "description": "letterlijke bronformulering; bij tabelcellen de letterlijke rijtekst, geen reconstructie"
    },
    "evidence_access": {
      "enum": [
        "full_text",
        "abstract_only"
      ]
    },
    "publication_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "study_design": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "feature_label_original": {
      "type": [
        "string",
        "null"
      ],
      "description": "label zoals in de bron (verplicht in raw/ als feature_id leeg is)"
    },
    "period": {
      "type": [
        "string",
        "null"
      ],
      "description": "kalenderperiode of kolom (bijv. 1990-1995), los van ziektefase timing"
    },
    "denominator_description": {
      "type": [
        "string",
        "null"
      ],
      "description": "wie is de noemer als die niet het cohort-N is (bijv. 68 overledenen)"
    },
    "percentage_qualifier": {
      "enum": [
        "exact",
        "about",
        "up_to",
        "range",
        null
      ]
    },
    "percentage_range": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "finding_direction": {
      "enum": [
        "abnormal",
        "normal",
        "negative",
        "positive",
        null
      ],
      "description": "gebruik als de bron 'negatief in X%' of 'normaal in X%' rapporteert; reken niet 100-X"
    },
    "source_type": {
      "enum": [
        "primary_cohort",
        "registry",
        "systematic_review",
        "meta_analysis",
        "review_citing_primary",
        "guideline",
        "classification_study",
        "case_series",
        "case_report"
      ]
    },
    "cited_source": {
      "type": [
        "object",
        "null"
      ],
      "description": "alleen invullen als de tekst de bewering zelf aan een citaat koppelt: {ref_label, pmid, doi, n}"
    },
    "table_context": {
      "type": [
        "string",
        "null"
      ],
      "description": "kolomkop/periode/rijpad bij tabelcellen; original_text blijft de letterlijke tekst"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "conflicts_with": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  }
}